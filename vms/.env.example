DB_NAME=vms
DB_USER=vmsadmin
DB_PASSWORD=
DJANGO_SECRET_KEY=

# AI Matching fields
AI_SERVICE=bedrock
AWS_ACCESS_KEY_ID= # Needs set up 
AWS_SECRET_ACCESS_KEY= # Needs set up
AWS_REGION=us-east-1 # Alter as needed 
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0 

NEXTAUTH_SECRET=
NEXTAUTH_URL="localhost:3000"
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Front End E.G.: fetch(`${process.env.NEXT_PUBLIC_BASE_URL}/api/volunteers/`)

EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Email / Notifications
# ---------------------------------------------------------------------------
# Development (default — prints to console, no credentials needed):
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production — AWS SES via SMTP:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=email-smtp.us-east-1.amazonaws.com   # adjust region
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=<SES SMTP username from IAM/SES console>
#   EMAIL_HOST_PASSWORD=<SES SMTP password>
#   DEFAULT_FROM_EMAIL=noreply@yourdomain.com        

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@hespulseup.example.com

# Path where outgoing emails are saved as .eml files.
# Defaults to <BASE_DIR>/email_dumps if not set.
# Future: replace with an S3 path, e.g. s3://your-bucket/email-dumps/
EMAIL_DUMP_PATH=/var/app/email_dumps

TWILIO_ACCOUNT_SID = os.environ.get('TWILIO_ACCOUNT_SID', '')
TWILIO_AUTH_TOKEN = os.environ.get('TWILIO_AUTH_TOKEN', '')
TWILIO_PHONE_NUMBER = os.environ.get('TWILIO_PHONE_NUMBER', '')